{
  "extends": "../../tsconfig.nextjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@mjn/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@mjn/types": [
        "../../packages/types/src/index.ts"
      ]
    },
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
